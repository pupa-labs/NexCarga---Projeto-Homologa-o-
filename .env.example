# GEMINI_API_KEY: Chave exclusiva de backend para o assistente inteligente NexIA (@google/genai).
# Nunca exponha esta chave no frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base da plataforma NexCarga para links de indicação, QR Codes e webhooks.
APP_URL="https://nexcarga.com.br"

# TIMEZONE DE NEGÓCIO OFICIAL (NexPoint / Contratos / Auditoria)
TZ="America/Sao_Paulo"

# SUPABASE POSTGRESQL / AUTH / STORAGE (Configuração modular para produção)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-server-only"

# GOOGLE MAPS PLATFORM (Opcional para renderização vetorial ao vivo no NexRadar)
VITE_GOOGLE_MAPS_API_KEY=""

# MERCADO PAGO (Integração futura preparada para webhooks e cobranças no servidor)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# SERVIÇO DE E-MAIL E NOTIFICAÇÕES
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
